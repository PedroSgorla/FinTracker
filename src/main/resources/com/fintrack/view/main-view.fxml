<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fintrack.ui.MainController" styleClass="root-pane">

    <top>
        <VBox spacing="12" styleClass="header">
            <padding>
                <Insets top="16" right="16" bottom="14" left="16"/>
            </padding>
            <Label text="FinTrack" styleClass="title"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by description..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="filterComboBox" prefWidth="170"/>
                <Button fx:id="newButton" text="New" onAction="#onNew" styleClass="primary"/>
                <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger"/>
                <Button fx:id="reportButton" text="Report" onAction="#onReport"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="transactionTable">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="110"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="360"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="140"/>
            </columns>
            <BorderPane.margin>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="28" alignment="CENTER_LEFT" styleClass="summary-bar">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label fx:id="incomeLabel" styleClass="income-amount"/>
            <Label fx:id="expensesLabel" styleClass="expense-amount"/>
            <Label fx:id="balanceLabel" styleClass="balance-text"/>
        </HBox>
    </bottom>

</BorderPane>
