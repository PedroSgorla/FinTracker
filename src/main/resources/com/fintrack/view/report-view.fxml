<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fintrack.ui.ReportController"
      spacing="16" styleClass="form-pane">

    <padding>
        <Insets top="22" right="26" bottom="22" left="26"/>
    </padding>

    <Label text="Financial summary" styleClass="title"/>

    <GridPane hgap="28" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints minWidth="120"/>
        </columnConstraints>

        <Label text="Transactions" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="countLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Total income" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="incomeLabel" styleClass="income-amount" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Total expenses" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="expensesLabel" styleClass="expense-amount" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Balance" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="balanceLabel" styleClass="balance-text" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <BarChart fx:id="barChart" animated="false" prefWidth="440" prefHeight="280">
        <xAxis>
            <CategoryAxis side="BOTTOM"/>
        </xAxis>
        <yAxis>
            <NumberAxis side="LEFT"/>
        </yAxis>
    </BarChart>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" defaultButton="true" onAction="#onClose" styleClass="primary"/>
    </HBox>

</VBox>
